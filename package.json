{
  "name": "env-bakery",
  "version": "0.0.0",
  "private": true,
  "license": "BSD-2-Clause",
  "scripts": {
    "format": "dprint fmt",
    "format:check": "dprint check",
    "ng": "ng",
    "start": "ng serve",
    "prebuild": "node copy-assets.js",
    "build": "ng build lib --configuration production",
    "postbuild": "npm run build:schematics",
    "watch": "ng build lib --watch",
    "test": "ng test lib --watch=false",
    "lint": "ng lint",
    "publish": "npm publish dist/lib/",
    "parbake": "node projects/lib/assets/bin/parbake.js",
    "prepare": "husky",
    "build:schematics": "tsc -p projects/lib/tsconfig.schematics.json",
    "copy:schemas": "cpy --cwd=projects/lib schematics/**/schema.json dist/lib/schematics",
    "copy:files": "cpy --cwd=projects/lib schematics/**/files/** dist/lib/schematics",
    "copy:collection": "cpy --cwd=projects/lib schematics/collection.json ../../dist/lib",
    "postbuild:schematics": "npm run copy:schemas && npm run copy:files && npm run copy:collection"
  },
  "dependencies": {
    "@angular/animations": "22.2.3",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/platform-browser-dynamic": "22.2.3",
    "@angular/router": "22.2.3",
    "dotenv": "18.0.8",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/core": "22.2.2",
    "@angular-devkit/schematics": "22.2.2",
    "@angular-eslint/builder": "22.6.0",
    "@angular-eslint/eslint-plugin": "22.6.0",
    "@angular-eslint/eslint-plugin-template": "22.6.0",
    "@angular-eslint/schematics": "22.6.0",
    "@angular-eslint/template-parser": "22.6.0",
    "@angular/build": "22.2.2",
    "@angular/cli": "22.2.4",
    "@angular/compiler-cli": "22.2.3",
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "24.19.2",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "angular-eslint": "22.6.0",
    "cpy-cli": "4.2.0",
    "dprint": "0.63.0",
    "eslint": "10.12.0",
    "husky": "9.1.7",
    "jsdom": "30.1.3",
    "ng-packagr": "22.2.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
